# Ung dung - cong mac dinh 3005
NODE_ENV=development
PORT=3005

# Supabase - password trong URL phai URL-encode; khong them sslmode vao URL
DATABASE_URL=postgresql://notification_app.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Chi dung khi chay npm run migrate; runtime khong can tai khoan nay.
MIGRATION_DATABASE_URL=postgresql://notification_migrator.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DB_SSL_ENABLED=true
DB_SSL_CA_PATH=./certs/supabase-ca.crt

# Auth - public key tu service Auth; issuer/audience phai khop token
JWT_PUBLIC_KEY_PATH=./keys/auth-public.pem
JWT_ISSUER=restaurant-auth
JWT_AUDIENCE=restaurant-api

# RabbitMQ Docker local - AMQP localhost:5675; quan tri http://localhost:15675
RABBITMQ_URL=amqp://notification_dev:CHANGE_ME_LOCAL_PASSWORD@localhost:5675
RABBITMQ_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
RABBITMQ_USER=notification_dev

# Email demo - worker gui thu vao Mailpit, khong gui den hop thu that.
DELIVERY_WORKER_ENABLED=true

# Mailpit - xem email tai http://localhost:8025; khong can tai khoan SMTP.
# SMTP port 1025, khong TLS. Chay Node: localhost; Docker: mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TableBooking <notification@example.test>"
